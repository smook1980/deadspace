#!/usr/bin/env ruby
# frozen_string_literal: true

# Static dead code report for a Rails 7 app: unused modules, classes, methods, and controller
# actions without a route. Run it directly (not via the app's `bundle exec`):
#
#   BUNDLE_GEMFILE=script/dead_code/Gemfile bundle install   # once
#   script/dead_code/analyze                                  # terminal report for the current dir
#   script/dead_code/analyze --csv tmp/dead_code.csv          # also write a CSV
#   script/dead_code/analyze --help
ENV["BUNDLE_GEMFILE"] = File.expand_path("Gemfile", __dir__)
begin
  require "bundler/setup"
rescue LoadError, StandardError => e
  abort "#{e.message}\nInstall the analyzer's gems first: BUNDLE_GEMFILE=#{ENV.fetch("BUNDLE_GEMFILE",
                                                                                     nil)} bundle install"
end
require "optparse"
require_relative "lib/dead_code"

options = { color: $stdout.tty?, routes: :static, only: nil, paths: [] }
parser = OptionParser.new do |o|
  o.banner = "Usage: #{$PROGRAM_NAME} [options] [RAILS_ROOT (default: .)]"
  o.on("--csv PATH", "Also write findings to PATH and removable tests to PATH_tests.csv") { |v| options[:csv] = v }
  o.on("--config PATH", "YAML overrides (default: RAILS_ROOT/.dead_code.yml if present)") { |v| options[:config] = v }
  o.on("--routes-json PATH",
       "Use routes dumped from the booted app (dump_routes.rb) instead of parsing routes.rb") do |v|
    options[:routes] = v
  end
  o.on("--no-routes", "Skip route analysis (every public controller method counts as an action)") do
    options[:routes] = nil
  end
  o.on("--only LEVEL", %w[unused likely], "Only report 'unused' or 'likely' findings") { |v| options[:only] = v }
  o.on("--path PREFIX", "Only report findings under this path (repeatable); analysis is still app-wide") do |v|
    options[:paths] << v
  end
  o.on("--quiet", "No terminal report (use with --csv)") { options[:quiet] = true }
  o.on("--[no-]color", "Colorize output (default: when stdout is a TTY)") { |v| options[:color] = v }
  o.on("--verbose", "Print parse and route warnings") { options[:verbose] = true }
end
parser.parse!
root = File.expand_path(ARGV.first || ".")
unless File.exist?(File.join(root, "config/application.rb"))
  abort "#{root} does not look like a Rails app (no config/application.rb)"
end

started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
config = DeadCode::Config.load(root, options[:config])
routes =
  case options[:routes]
  when nil then nil
  when :static
    files = DeadCode::Collector.new(root, config).files("routes_globs")
    if files.empty?
      (warn "No routes files found; skipping route analysis")
    else
      DeadCode::RouteParser.new(root,
                                files).parse
    end
  else DeadCode::RouteTable.from_json(options[:routes])
  end

# Don't analyze this tool when it lives inside the app it is analyzing.
tool_dir = File.expand_path(__dir__)
exclude = tool_dir.start_with?("#{root}/") ? ["#{tool_dir.delete_prefix("#{root}/")}/"] : []
findings, index = DeadCode.analyze(root, config:, routes:, exclude_paths: exclude)

if options[:only]
  findings = findings.select do |f|
    f.confidence == (options[:only] == "unused" ? :unused : :likely_unused)
  end
end
findings = findings.select { |f| options[:paths].any? { |p| f.location.path.start_with?(p) } } if options[:paths].any?

report = DeadCode::Report.new(findings, index:, routes:, root:,
                                        elapsed: Process.clock_gettime(Process::CLOCK_MONOTONIC) - started)
report.print_terminal($stdout, color: options[:color], verbose: options[:verbose]) unless options[:quiet]
if options[:csv]
  tests_path = report.write_csv(options[:csv])
  test_rows = findings.sum { |f| f.tests.size }
  warn "Wrote #{findings.size} findings to #{options[:csv]} and #{test_rows} removable test blocks to #{tests_path}"
end
